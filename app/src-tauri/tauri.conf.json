{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "guif-player",
  "mainBinaryName": "guif-player",
  "version": "0.1.1",
  "identifier": "dev.guif.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "guif-player",
        "width": 1100,
        "height": 750,
        "minWidth": 720,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "guif",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Japanese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
